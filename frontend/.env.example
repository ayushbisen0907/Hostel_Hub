# Base URL of the HostelHub API.
# Leave as /api in development (Vite proxies it to API_PROXY_TARGET).
# In production set it to your deployed API, e.g. https://api.example.com/api
VITE_API_URL=/api

# Where the Vite dev server forwards /api requests
API_PROXY_TARGET=http://localhost:4000

# Where owners contact you to buy / renew a plan (Settings → Plan & billing).
# Leave empty to show only the "Copy message" button.
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=
